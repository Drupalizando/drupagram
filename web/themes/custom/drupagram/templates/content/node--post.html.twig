{#
  Template para o Post de Foto do Drupagram.
  Cada bloco só aparece se tiver conteúdo de verdade: renderizamos para texto e
  descartamos os espaços, porque um array de render "não vazio" pode gerar HTML vazio.
#}
{% set actions %}{{ content.flag_curtir }}{% endset %}
{% set descricao %}{{ content.field_descricao }}{% endset %}
{% set hashtags %}{{ content.field_hashtags }}{% endset %}
{% set comentarios %}{{ content.field_comentarios }}{% endset %}
<article{{ attributes.addClass('node--type-post', 'node--view-mode-' ~ view_mode) }}>

  <header class="node__meta">
    {{ author_picture }}
    <span class="node__author">{{ author_name }}</span>
    <span class="node__date">{{ date }}</span>
  </header>

  <div class="node__content">
    {{ content.field_foto }}

    {% if can_like and actions|trim is not empty %}
      <div class="node__actions">
        {{ actions }}
      </div>
    {% endif %}

    {% if descricao|striptags('<img>')|trim is not empty %}
      <div class="node__descricao">
        {{ descricao }}
      </div>
    {% endif %}

    {% if hashtags|striptags('<img>')|trim is not empty %}
      <div class="node__hashtags">
        {{ hashtags }}
      </div>
    {% endif %}

    {% if comentarios|trim is not empty %}
      <div class="node__comentarios">
        {{ comentarios }}
      </div>
    {% endif %}
  </div>

</article>
