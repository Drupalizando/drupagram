<?php

/**
 * @file
 * Functions to support theming.
 */

/**
 * Implements hook_preprocess_image_widget().
 */
function drupagram_preprocess_image_widget(array &$variables) {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}

/**
 * Implements hook_preprocess_node().
 */
function drupagram_preprocess_node(array &$variables) {
  // O link de curtir é montado depois (placeholder), então o template não sabe
  // se ele vai ficar vazio. Perguntamos pela permissão para não gerar uma barra vazia.
  $variables['can_like'] = \Drupal::currentUser()->hasPermission('flag curtir');
  $variables['#cache']['contexts'][] = 'user.permissions';
}
